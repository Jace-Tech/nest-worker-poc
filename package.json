{
  "name": "queue-lab",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:worker": "pnpm --filter @queue-lab/shared build && pnpm --filter @queue-lab/worker start:dev",
    "dev:web": "pnpm --filter @queue-lab/shared build && pnpm --filter @queue-lab/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
