# Local dev. On Vercel, set REDIS_URL as a (production) Environment Variable.
# TCP connection string. Upstash gives a rediss:// URL.
REDIS_URL=redis://localhost:6379

# Optional: max jobs enqueued per POST /api/jobs. Requests above this return 400.
# Defaults to 25000 (keeps a single request inside the Vercel function time limit).
# MAX_JOBS_PER_REQUEST=25000
